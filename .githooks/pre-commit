#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if ! git diff --quiet -- || [ -n "$(git ls-files --others --exclude-standard)" ]; then
  echo "Warning: tests run against the working tree, including unstaged/untracked files." >&2
fi

if [ -n "${PHASEFINDER_TEST_PYTHON:-}" ]; then
  PYTHON="$PHASEFINDER_TEST_PYTHON"
elif [ -x "$ROOT/.venv/bin/python" ]; then
  PYTHON="$ROOT/.venv/bin/python"
else
  PYTHON="$(command -v python3 || true)"
fi

if [ -z "$PYTHON" ] || [ ! -x "$PYTHON" ]; then
  echo "Commit blocked: set PHASEFINDER_TEST_PYTHON or install python3." >&2
  exit 1
fi

"$PYTHON" -m unittest discover -s tests/ci -p 'test_*.py'
"$PYTHON" scripts/check_supply_chain.py --static
