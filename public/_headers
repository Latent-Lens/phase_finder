/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-QegSXuCeGvs/PPT8u2DSB5HlR9rojffhnwsctbN4gdE='; style-src-elem 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
